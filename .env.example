# =========================================================================
# CHESS MULTIPLAYER PLATFORM — ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Add to Vercel Project Settings)
# -------------------------------------------------------------------------
VITE_API_URL=https://your-chess-backend.onrender.com
VITE_SOCKET_URL=https://your-chess-backend.onrender.com

# -------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Add to Render / Railway / Host)
# -------------------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vkstyma.mongodb.net/chess?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_key_here_change_me
CLIENT_URL=https://your-chess-app.vercel.app
NODE_ENV=production

