# ========================================================
# BACKEND ENVIRONMENT VARIABLES (Node.js Host / Render / Railway)
# ========================================================

# Server Port (usually assigned automatically by host)
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vkstyma.mongodb.net/chess?retryWrites=true&w=majority

# JWT secret key for signing user auth tokens
JWT_SECRET=your_production_jwt_secret_key_here_change_me

# Allowed client URL for CORS (your Vercel frontend URL)
CLIENT_URL=https://your-chess-app.vercel.app

# Environment mode
NODE_ENV=production
