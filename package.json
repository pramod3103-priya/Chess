{
  "name": "chess-platform",
  "version": "1.0.0",
  "description": "Production-ready MERN Stack Real-time Chess Platform with Socket.IO, chess.js, React and MongoDB",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "vercel-build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client && npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.1",
    "mongodb-memory-server": "^10.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}